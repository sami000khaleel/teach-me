# ---- Authentication (REQUIRED — the server refuses to start without it) ----
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste_a_long_random_string_here_at_least_32_chars
# optional, default 7d
# JWT_EXPIRES_IN=7d

# ---- Database CA certificate (REQUIRED on Render) ----
# ca.pem is git-ignored, so it is not deployed. Paste the whole certificate text
# (Aiven Console -> MySQL -> CA certificate) into this variable in Render.
# DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ---- CORS: your site's address, e.g. https://teachme.onrender.com (comma separated). "*" = anyone ----
CLIENT_ORIGIN=https://your-app.onrender.com

# ---- Cloudflare R2 (profile images) ----
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_api_token_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_api_token_secret_access_key
R2_BUCKET=teachme-profiles
# Public Development URL of the bucket (no trailing slash)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# AI_SERVICE_URL is no longer used — you can delete it from Render.
