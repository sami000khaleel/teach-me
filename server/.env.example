# ===================================================================
# Server .env — used ONLY when running `node index.js` on the host.
# Inside Docker, values in ../.env take precedence.
# ===================================================================

PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---------- MySQL (host-side: use the mapped host ports) ----------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=teachme_app
DB_PASSWORD=ChangeMe
DB_NAME=project

# ---------- MongoDB (host-side: use the mapped host port) ----------
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_DB=teachMe
MONGO_USER=teachme
MONGO_PASSWORD=ChangeMe

# ---------- Email (Gmail) ----------
GMAIL_USER=samihellstrong@gmail.com
GMAIL_APP_PASSWORD=YouCanDoItOptional

# ---------- TLS (host-only) ----------
USE_HTTPS=true
SSL_CA_PATH=./ca.crt
SSL_CERT_PATH=./cert.crt
SSL_KEY_PATH=./cert.key

# ---------- AI (host-side — change to https:// if using TLS) ----------
AI_SERVICE_URL=http://127.0.0.1:5000